# Служебные файлы серверной части закрыты от скачивания.
# Наружу смотрят только submit.php (приём формы) и install.php (под ключом).
<FilesMatch "^(secret\.php|secret\.sample\.php|config\.php|form-lib\.php|schema\.sql|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(submit|install)\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
