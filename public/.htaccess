# Постоянное перенаправление с HTTP на HTTPS.
#
# Почему проверяем именно X-Forwarded-Proto, а не %{HTTPS}:
# перед Apache стоит nginx, он принимает защищённое соединение и передаёт
# запрос дальше уже обычным HTTP. Для Apache любой запрос выглядит как
# незащищённый, поэтому привычное правило «если не HTTPS — перенаправить»
# срабатывало бы всегда и увело сайт в бесконечный цикл редиректов.
#
# Если заголовка нет вовсе — перенаправление просто не происходит.
# Это осознанный выбор: лучше не перенаправить, чем уронить сайт.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
